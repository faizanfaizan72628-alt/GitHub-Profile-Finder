
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #0d1117;
    color: #f0f6fc;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.container {
    width: 100%;
    max-width: 500px;
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 18px;
    padding: 30px;
    text-align: center;
}

h1 {
    color: #58a6ff;
    margin-bottom: 10px;
}

.subtitle {
    color: #8b949e;
    margin-bottom: 25px;
}

form {
    display: flex;
    gap: 10px;
}

form input {
    flex: 1;
    min-width: 0;
    padding: 12px;
    border-radius: 8px;
    border: 1px solid #30363d;
    background: #0d1117;
    color: white;
    outline: none;
}

form input:focus {
    border-color: #58a6ff;
}

button, #profileLink {
    background: #238636;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 12px 16px;
    cursor: pointer;
    font-weight: bold;
    text-decoration: none;
}

button:hover, #profileLink:hover {
    background: #2ea043;
}

button:disabled {
    opacity: 0.6;
    cursor: wait;
}

#message {
    margin: 18px 0;
    color: #f0b429;
    min-height: 18px;
}

.profile {
    border-top: 1px solid #30363d;
    padding-top: 25px;
    margin-top: 10px;
}

.hidden {
    display: none;
}

#avatar {
    width: 110px;
    height: 110px;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid #58a6ff;
    margin-bottom: 15px;
}

.profile h2 {
    margin-bottom: 8px;
}

#login, #bio, #location {
    color: #8b949e;
    margin-bottom: 15px;
    overflow-wrap: anywhere;
}

.stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 25px 0;
}

.stats div {
    background: #21262d;
    padding: 14px 5px;
    border-radius: 10px;
}

.stats strong, .stats span {
    display: block;
}

.stats strong {
    color: #58a6ff;
    font-size: 20px;
    margin-bottom: 6px;
}

.stats span {
    font-size: 12px;
    color: #c9d1d9;
}

#profileLink {
    display: inline-block;
    margin-bottom: 10px;
}

footer {
    color: #6e7681;
    font-size: 12px;
    margin-top: 25px;
}

@media (max-width: 400px) {
    .container {
        padding: 20px 14px;
    }

    form {
        flex-direction: column;
    }

    .stats span {
        font-size: 11px;
    }
}
